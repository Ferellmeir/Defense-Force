{
  "name": "tower-defence",
  "version": "0.0.2",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "webpack serve --mode development",
    "desktop": "electron .",
    "build": "webpack --mode production && node scripts/write-build-info.cjs",
    "build:launcher": "electron-builder --config electron-builder.launcher.yml --win portable && node scripts/copy-launcher.cjs",
    "package:win": "npm run build && electron-builder --win nsis portable",
    "package:win:installer": "npm run build && electron-builder --win nsis",
    "package:win:portable": "npm run build && electron-builder --win portable",
    "generate-assets": "node src/assets-generator.js",
    "lint": "eslint 'src/**/*.{js,json,md}'",
    "format": "prettier --write 'src/**/*.{js,json,md}'",
    "prepare": "husky install"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "description": "Sci-fi tower-defense RPG",
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "babel-loader": "^10.0.0",
    "canvas": "^3.1.0",
    "copy-webpack-plugin": "^13.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^8.20.0",
    "html-webpack-plugin": "^5.6.3",
    "husky": "^8.0.2",
    "lint-staged": "^13.0.4",
    "phaser": "^3.88.2",
    "prettier": "^2.8.0",
    "webpack": "^5.99.5",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.1"
  },
  "lint-staged": {
    "src/**/*.{js,json,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "build": {
    "appId": "com.scifi.towerdefense.rpg",
    "productName": "Sci-Fi Tower Defense RPG",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/diagnostics-preload.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
